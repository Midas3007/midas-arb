{
  "name": "midas-arb",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/hunter/main.ts",
    "check": "tsx src/hunter/check.ts",
    "report": "tsx src/hunter/report.ts",
    "treasury": "tsx src/hunter/treasury.ts",
    "withdraw": "tsx src/hunter/treasury.ts --withdraw",
    "new-wallet": "tsx src/new-wallet.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "dotenv": "16.4.5",
    "viem": "2.21.60"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "description": "Midas-arb: Peg Hunter. Finds pools where currency-pegged stablecoins trade away from their real exchange rate, on cheap-gas EVM chains, and trades them back",
  "engines": {
    "node": ">=20"
  }
}

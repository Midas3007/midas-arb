# ===== Midas-arb: Peg Hunter =====
# Copy to .env (cp .env.example .env) and fill in. Everything below the first block has a sensible default.

# --- wallet and the master switch ---
HUNTER_PRIVATE_KEY=            # a NEW wallet, only for Peg Hunter (npm run new-wallet). Same address on every chain.
HUNTER_LIVE=0                  # 0 = watch only (nothing is ever sent). 1 = trade on chains in "live" mode, and run the treasury.
# HUNTER_CHAINS=celo,base      # which chains run (default: celo,base, per docs/FX_SURVEY.md; all = every chain)
# FX_ONLY=1                    # trade currency coins only (default); 0 = dollar coins on every route too
# TEXTILE_USD=1                # with FX_ONLY: dollar coins (USAT, USDC) still trade against Textile, like Kiyoshi (0 = never)
# BASE_V4_TIERS=1500:30        # extra Uniswap v4 fee:tickSpacing tiers per chain (<CHAIN>_V4_TIERS); Base's 0.15%/30 is built in
# HUNTER_START_LIVE=           # chains that skip the 3-day watch, e.g. celo (first start only: a chain that is
#                              # already watching goes live with /chain base live on Telegram; /chain base auto to undo)
# TEST_TRADE=                  # e.g. base: one $2 live round trip on that chain to prove the trade path (needs HUNTER_LIVE=1)
# DAILY_REPORT_UTC=20          # hour (UTC) of the daily Telegram summary
# HUNTER_PAUSED=1              # emergency stop for new trades, overrides Telegram

# --- Telegram (alerts and commands: /status /chains /chain /gaps /withdraw /pause /resume) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_TRADE_USD=1            # message on every trade of at least this size

# --- what counts as a trade ---
# MIN_NET_USD=0.01             # smallest profit after gas and fees (Kiyoshi: $0.01 before gas)
# MIN_GAP_PCT=0                # optional floor as % of the trade (0 = off)
# MIN_TRADE_USD=50             # each route is tested at the largest trade, half and a quarter (never under this),
#                              # then the best size is refined
#                              # (a chain with less cash searches what it has, never under $2)
# TRADE_PCT=90                 # largest trade = this % of the chain's cash (the size search picks the best size up to it)...
# FLOOR_TRADE_USD=2            # ...but small wallets may trade up to this
# MAX_TRADE_USD_CAP=200        # ...and never more than this
# MAX_EXIT_IMPACT_BPS=100      # a trade may move the exit pool's price at most 1%
# MAX_SWAP_GAS_USD=0.01        # a chain only trades while a swap costs less than this

# --- safety ---
# TEXTILE_SELL_HAIRCUT_BPS=0   # Textile's firm quotes can come in under its previews: selling to it can be counted this
#                              # much lower; after 5+ real fills the bot uses the actual shortfall per coin
# MAX_DAILY_LOSS_USD=3         # per chain: stop new trades for the day after this realized loss
# GLOBAL_DAILY_LOSS_USD=5      # all chains together
# DEPEG_PCT=3                  # every pool of a coin this far off its peg = the coin depegged: frozen
# SUSPICIOUS_PCT=20            # a quote this far from fair = broken pool or fake token: skipped
# STUCK_HOURS=24               # a pool off its peg this long is skipped (something stops trading there)
# DEPEG_PCT_CCY=NGN:5,ARS:12   # wider depeg limits where crypto trades at the street rate, not the official one
# FAIR_AGREE_PCT=2             # fair-price sources must agree within this
# ALLOW_SINGLE_SOURCE=0        # 1 = trade a currency with only one fresh price source (not recommended)

# --- chain lifecycle (watch -> live -> paused) ---
# WATCH_DAYS=3                 # every chain watches first, at least this long
# PROMOTE_MIN_OPPS=5           # then goes live if it saw this many gaps...
# PROMOTE_MIN_USD=0.10         # ...worth this much in total
# WATCH_CAPITAL_USD=218        # watch mode sizes trades as if each chain held this much (your real capital)
# REVIEW_DAYS=7                # a live chain with no profit after gas over this many days is paused
# PAUSED_DAYS=7                # and watches again after this many

# --- treasury: deposits, gas, splitting cash, sweeping profit ---
# TREASURY_MIN=10              # minutes between rounds (only with HUNTER_LIVE=1)
# DEPOSIT_MIN_USD=2            # gas token above a $2 reserve and at least this much is swapped to cash
# GAS_TOPUP_USD=1              # a chain short of gas buys this much
# SPLIT_MIN_MOVE_USD=5         # smaller rebalancing moves are skipped
# SPLIT_MAX_FEE_PCT=2          # bridges costing more than this % are skipped
# MIN_SHARE_PCT=5              # every live chain gets at least this % of the cash
# MAX_SHARE_PCT=40             # and no more than this
# SWEEP_AT_USD=20              # sweep when profit not yet swept reaches this
# SWEEP_PCT=50                 # % of that profit to sweep (the rest keeps trading)
# SWEEP_MIN_CHAIN_USD=3        # a chain's part smaller than this waits for the next sweep
# SWEEP_CHAIN=bsc              # where swept profit goes
# SWEEP_TOKEN=                 # token address on SWEEP_CHAIN (default: its cash token, USDT on BSC)
# SWEEP_TO=                    # your own address (an exchange deposit address or your wallet). Empty = kept aside in the bot wallet.

# --- other income ---
# SAVINGS=1                    # 0 = never park idle cash in Aave
# SAVINGS_MIN_APY=1            # only chains where Aave pays at least this % on the cash token
# SAVINGS_MIN_MOVE_USD=5       # smaller amounts are not worth the gas of parking
# REWARDS_MIN=60               # check Merkl for claimable reward tokens this often (minutes)
# REWARDS_MIN_USD=1            # claim once they are worth this much on a chain

# --- scanning ---
# CHASE_SEC=5                  # chase mode (Kiyoshi's): the route with a gap is re-checked this often and traded again
# CHASE_MAX_MIN=10             # ...until the gap closes, for at most this long
# CHASE_AFTER_TRADE_SEC=1      # after a winning trade, the next check comes this soon
# JUNK_PCT=5                   # a route losing more than this % at every size is skipped...
# JUNK_MUTE_MIN=60             # ...for this long (or until a new pool appears)
# QUIET_PCT=0.5                # a chain whose best route stays further than this % from profit scans 2-3x less often
# APPROVAL_MULT=25             # each token approval covers this many trades (never unlimited)
# PERSIST_ALERT_MIN=30         # Telegram alert when a gap stays open this long on a chain that isn't trading it
# PREFILTER_FROM=20            # chains with more routes than this estimate them first, then quote the close ones
#                              # (only routes within 0.1% of covering their gas + MIN_NET_USD get exact quotes)
# BASE_INTERVAL_SEC=15         # Base's full scan interval (default 15); any chain: <CHAIN>_INTERVAL_SEC
# SCAN_TIMING=1                # print how long each part of a scan took
# INTERVAL_SEC=20              # full scan every this many seconds (plus instant rescans when a watched pool trades)
# MODE=both                    # both | scan | watch
# WATCH_MS=1500
# NEWPOOL_SEC=60               # check for brand-new pools of our coins this often
# OBSERVE_SEC=300              # refresh every pool's peg reading this often (depeg detection)
# RPC_CONCURRENCY=8            # quotes in flight at once per chain (free RPCs throttle bursts)

# --- Robinhood Chain (stock tokens) ---
# STOCK_AGREE_PCT=1.5          # Robinhood's price and Hyperliquid's must agree within this
# STOCK_SINGLE_SOURCE=1        # 0 = also require Hyperliquid (it lists fewer stocks)
# ROBINHOOD_MAX_STOCKS=25       # only the deepest stocks (by WETH in their pools); 0 = all 200+
# ROBINHOOD_STOCKS=NVDA,TSLA    # always watched
# ROBINHOOD_INTERVAL_SEC=120    # any chain: <CHAIN>_INTERVAL_SEC and <CHAIN>_WATCH_MS (Robinhood: 120 s and 15000 ms)
# ROBINHOOD_RPC_CONCURRENCY=8  # per chain: <CHAIN>_RPC_CONCURRENCY. Raise only with your own RPC: the public one
#                              # throttles heavy quotes, and a throttled check looks like "no pool"

# --- connections (defaults are free public RPCs; add your own if one is slow) ---
# CELO_RPCS=https://forno.celo.org
# BASE_RPCS=https://...,https://...
# BSC_RPCS= / POLYGON_RPCS= / ARBITRUM_RPCS= / OPTIMISM_RPCS= / AVALANCHE_RPCS= / GNOSIS_RPCS= / SEI_RPCS=

# --- more coins or exchanges without code changes ---
# BASE_PEGS=SYMBOL:0xaddress:CCY,...          (symbol must match on-chain; CCY e.g. EUR, NGN)
# SEI_DEXES=name|0xFactory|0xQuoterV2|0xRouter|02;...   (Uniswap-v3-style; style 02 or v1)

# --- FX quote API (npm run fx-api, or inside the bot with FX_API_PORT) ---
# FX_API_PORT=8080             # the bot serves /fx on this port (npm run fx-api uses PORT, then this)
# FX_API_CHAINS=celo,base,bsc,polygon   # chains npm run fx-api covers (default: these four)
# FX_API_KEYS=                 # comma-separated keys; callers send x-api-key and are served free
# X402_PRICE_USD=              # e.g. 0.01: everyone else pays per call (x402 v2 and v1, USDC on Base)
# X402_PAY_TO=                 # where payments go: your own Base address (required without HUNTER_PRIVATE_KEY)
# X402_FACILITATOR_URL=        # default https://facilitator.payai.network (settles, pays gas, lists in its Bazaar); self = the bot wallet settles
# PUBLIC_URL=                  # the API's public https address (used in the discovery documents)
# API_CONTACT_EMAIL=           # optional: shown publicly in /openapi.json (x402scan verifies ownership with it)
# X402_CELO_API_KEY=           # secret from x402.celo.org: also accept USDT/USDC on Celo (Celo's facilitator settles)
# X402_PAY_TO_CELO=            # where Celo payments go (default: X402_PAY_TO)
# ERC8004_AGENT_ID=            # after npm run register-agent: the id it prints (listed in /.well-known/agent-registration.json)
# FX_RECORD_MIN=30             # record $100/$1,000/$10,000 quotes for every currency this often (0 = off; lower = more bandwidth)

# --- other ---
# DATA_DIR=data
# ATTRIBUTION_TAG=celo_f6214d29d540   # Celo only: Kiyoshi's original builder's tag on each tx; empty to turn off
# BASE_BUILDER_CODE=           # your Base Builder Code (bc_...), added to every Base transaction (Base grant requirement);
#                              # any chain: <CHAIN>_BUILDER_CODE (CELO_BUILDER_CODE replaces ATTRIBUTION_TAG)

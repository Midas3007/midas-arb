# --- required ---
AGENT_PRIVATE_KEY=0x...

# --- trading (defaults shown) ---
LIVE=0                      # 1 = trade real money; 0 = dry run (scan and print only)
MAX_TRADE_USD=70            # largest trade; never more than 90% of the USDT held
MIN_TRADE_USD=2
MIN_EDGE_USD=0.02           # minimum expected profit AFTER gas
INTERVAL_SEC=20             # seconds between scans
MAX_DAILY_LOSS_USD=5        # stop opening trades for the rest of the day after this realized loss (0 = off)

# --- safety ---
MAX_FLATTEN_LOSS_BPS=50     # leftover coins may be sold at up to 0.5% loss...
MAX_HOLD_MIN=30             # ...or at any price after this many minutes
ROUTE_COOLDOWN_MIN=5        # skip a route for this long after it fails
APPROVAL_MODE=capped        # capped (4 trades' worth) | exact | unlimited

# --- markets ---
VENUES=uniswap,textile,mento
# CORRIDORS=wBRL,wARS,cNGN,BRLm,KESm   # default: every token in src/config.ts; discovery keeps the tradable ones
REDISCOVER_HOURS=6

# --- connection ---
CELO_RPC=https://forno.celo.org
# CELO_RPCS=https://another-celo-rpc,https://a-third-one   # backups, used if the first fails

# --- optional ---
# TELEGRAM_BOT_TOKEN=          # alerts for trades, failures and errors (see README)
# TELEGRAM_CHAT_ID=
# ATTRIBUTION_TAG=celo_f6214d29d540   # the original builder's tag on every tx; set empty to turn off
# DATA_DIR=.

# ---- Multi-chain desk (BSC / Polygon): npm run multi -- bsc polygon ----
# A NEW wallet, separate from the Celo one above (make one with: npm run new-wallet)
MULTI_PRIVATE_KEY=
MULTI_LIVE=0
MULTI_MAX_TRADE_USD=20
MULTI_MIN_EDGE_USD=0.02
MULTI_MAX_DAILY_LOSS_USD=3
# Optional: backup RPCs, extra tokens (SYMBOL:0xaddress:decimals), or a narrower token list
# BSC_RPCS=https://...,https://...
# BSC_TOKENS=cNGN:0x...:6
# POLYGON_CORRIDORS=USDC,BRZ
# Sei: exchange addresses are not built in. Add Uniswap-v3-style exchanges (factory, QuoterV2, router; style 02 or v1):
# SEI_DEXES=dragonswap|0xFactory|0xQuoterV2|0xRouter|02;sailor|0x...|0x...|0x...|02
# Trade against another dollar token on a chain (the one its pools actually use), e.g.:
# SEI_CASH=USDT0

# ===== Midas-arb: Peg Hunter =====
# Copy to .env (cp .env.example .env) and fill in. Everything below the first block has a sensible default.

# --- wallet and the master switch ---
HUNTER_PRIVATE_KEY=            # a NEW wallet, only for Peg Hunter (npm run new-wallet). Same address on every chain.
HUNTER_LIVE=0                  # 0 = watch only (nothing is ever sent). 1 = trade on chains in "live" mode, and run the treasury.
# HUNTER_CHAINS=celo,base,bsc,polygon,arbitrum,optimism,avalanche,gnosis,sei   # which chains run (default: all)
# HUNTER_START_LIVE=           # chains that skip the 3-day watch, e.g. celo (set by hand; /chain celo auto to undo)
# HUNTER_PAUSED=1              # emergency stop for new trades, overrides Telegram

# --- Telegram (alerts and commands: /status /chains /chain /gaps /withdraw /pause /resume) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_TRADE_USD=1            # message on every trade of at least this size

# --- what counts as a trade ---
# MIN_GAP_PCT=0.3              # profit after gas and fees, as % of the trade
# MIN_NET_USD=0.01             # and at least this many dollars
# MIN_TRADE_USD=0.5
# TRADE_PCT=20                 # largest trade = this % of the chain's cash...
# FLOOR_TRADE_USD=2            # ...but small wallets may trade up to this
# MAX_TRADE_USD_CAP=100        # ...and never more than this
# MAX_EXIT_IMPACT_BPS=100      # a trade may move the exit pool's price at most 1%
# MAX_SWAP_GAS_USD=0.01        # a chain only trades while a swap costs less than this

# --- safety ---
# MAX_DAILY_LOSS_USD=3         # per chain: stop new trades for the day after this realized loss
# GLOBAL_DAILY_LOSS_USD=5      # all chains together
# DEPEG_PCT=3                  # every pool of a coin this far off its peg = the coin depegged: frozen
# SUSPICIOUS_PCT=20            # a quote this far from fair = broken pool or fake token: skipped
# STUCK_HOURS=24               # a pool off its peg this long is skipped (something stops trading there)
# FAIR_AGREE_PCT=2             # fair-price sources must agree within this
# ALLOW_SINGLE_SOURCE=0        # 1 = trade a currency with only one fresh price source (not recommended)

# --- chain lifecycle (watch -> live -> paused) ---
# WATCH_DAYS=3                 # every chain watches first, at least this long
# PROMOTE_MIN_OPPS=5           # then goes live if it saw this many gaps...
# PROMOTE_MIN_USD=0.10         # ...worth this much in total (sized as if it held WATCH_SIZE_USD)
# WATCH_SIZE_USD=20
# REVIEW_DAYS=7                # a live chain with no profit after gas over this many days is paused
# PAUSED_DAYS=7                # and watches again after this many

# --- treasury: deposits, gas, splitting cash, sweeping profit ---
# TREASURY_MIN=10              # minutes between rounds (only with HUNTER_LIVE=1)
# DEPOSIT_MIN_USD=2            # gas token above a $2 reserve and at least this much is swapped to cash
# GAS_TOPUP_USD=1              # a chain short of gas buys this much
# SPLIT_MIN_MOVE_USD=5         # smaller rebalancing moves are skipped
# SPLIT_MAX_FEE_PCT=2          # bridges costing more than this % are skipped
# MIN_SHARE_PCT=5              # every live chain gets at least this % of the cash
# MAX_SHARE_PCT=40             # and no more than this
# SWEEP_AT_USD=20              # sweep when profit not yet swept reaches this
# SWEEP_PCT=50                 # % of that profit to sweep (the rest keeps trading)
# SWEEP_MIN_CHAIN_USD=3        # a chain's part smaller than this waits for the next sweep
# SWEEP_CHAIN=bsc              # where swept profit goes
# SWEEP_TOKEN=                 # token address on SWEEP_CHAIN (default: its cash token, USDT on BSC)
# SWEEP_TO=                    # your own address (an exchange deposit address or your wallet). Empty = kept aside in the bot wallet.

# --- scanning ---
# INTERVAL_SEC=20              # full scan every this many seconds (plus instant rescans when a watched pool trades)
# MODE=both                    # both | scan | watch
# WATCH_MS=1500
# NEWPOOL_SEC=60               # check for brand-new pools of our coins this often
# OBSERVE_SEC=300
# RPC_CONCURRENCY=8            # quotes in flight at once per chain (free RPCs throttle bursts)              # refresh every pool's peg reading this often (depeg detection)

# --- connections (defaults are free public RPCs; add your own if one is slow) ---
# CELO_RPCS=https://forno.celo.org
# BASE_RPCS=https://...,https://...
# BSC_RPCS= / POLYGON_RPCS= / ARBITRUM_RPCS= / OPTIMISM_RPCS= / AVALANCHE_RPCS= / GNOSIS_RPCS= / SEI_RPCS=

# --- more coins or exchanges without code changes ---
# BASE_PEGS=SYMBOL:0xaddress:CCY,...          (symbol must match on-chain; CCY e.g. EUR, NGN)
# SEI_DEXES=name|0xFactory|0xQuoterV2|0xRouter|02;...   (Uniswap-v3-style; style 02 or v1)

# --- other ---
# DATA_DIR=data
# ATTRIBUTION_TAG=celo_f6214d29d540   # Celo only: Kiyoshi's original builder's tag on each tx; empty to turn off
